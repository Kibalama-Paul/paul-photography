PORT=3000

# ==============================================================================
# CLIENT PROOFING FRONTEND SETTINGS (VITE_*)
# ==============================================================================
# Keep "true" for instant local preview using sample proofing sessions.
# Set to "false" to fetch galleries strictly from Google Drive via /api/gallery.
VITE_USE_MOCK_DATA=true
VITE_BRAND_NAME="Paul Photography 256"
VITE_DEFAULT_SESSION_ID="kampala-editorial-2026"

# Optional external API base URL (leave blank when served on same origin)
VITE_API_BASE_URL=

# ==============================================================================
# PHOTOGRAPHER ADMIN DASHBOARD PASSCODE (Server-side only)
# ==============================================================================
ADMIN_PASSCODE="2567"

# ==============================================================================
# CLOUDFLARE R2 OBJECT STORAGE (Zero Egress Fees for Client Photo Proofing)
# ==============================================================================
# 10 GB Free Storage forever. Unlimited downloads with $0 bandwidth fees.
# 1. Cloudflare Account ID (Found in Cloudflare Dashboard -> R2 Overview)
R2_ACCOUNT_ID=
# 2. R2 API Token Access Key ID & Secret Access Key (Cloudflare -> R2 -> Manage R2 API Tokens)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 3. R2 Bucket Name (e.g. paul-photography-proofing)
R2_BUCKET_NAME=
# 4. Public Bucket URL (e.g. https://pub-xxxxxx.r2.dev or custom domain https://photos.paulphotography256.com)
R2_PUBLIC_URL=

# ==============================================================================
# SERVER-SIDE GOOGLE DRIVE & SHEETS INTEGRATION (Never prefix with VITE_)
# ==============================================================================
# 1. Google Service Account (Shared by Drive v3 & Sheets v4 REST APIs)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# 2. Google Drive Folder Mapping
GOOGLE_DRIVE_DEFAULT_FOLDER_ID=
GOOGLE_DRIVE_SESSION_FOLDERS='{"kampala-editorial-2026":"","studio-portraits-2026":""}'

# 3. Google Sheets Logging (Appends a row per client submission)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME="Selections"

# ==============================================================================
# SERVER-SIDE EMAIL NOTIFICATIONS (Configure Resend OR Nodemailer SMTP)
# ==============================================================================
PHOTOGRAPHER_EMAIL="paulphotography256@gmail.com"
EMAIL_FROM="Paul Photography 256 Proofing <proofing@paulphotography256.com>"

# Option A: Resend API (https://resend.com)
RESEND_API_KEY=

# Option B: Nodemailer SMTP (Used automatically if RESEND_API_KEY is unset)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Option C: Google Apps Script Webhook (Optional zero-server Sheets + Gmail bridge)
APPS_SCRIPT_WEBHOOK_URL=
